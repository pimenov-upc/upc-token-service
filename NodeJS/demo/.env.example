# Environment variables for the demo application
# ----------------------------------------------
# Use test for development; production sends real card data to production.
UPC_ENVIRONMENT=test

# Optional custom HTTPS server base URL (without /go/... API path suffixes).
# Example: UPC_BASE_URL=https://certsrv1.ad.upc.intranet:8443
UPC_BASE_URL=

# Enable redacted request/response diagnostics in the demo and SDK.
UPC_LOGGING=false

# Merchant and terminal identifiers for the demo application.
UPC_MERCHANT_ID=
UPC_TERMINAL_ID=

# XML requests are sent as plain XML over HTTPS. Use test card details in test mode.
UPC_CARD_NUMBER=
UPC_CARD_EXP_MONTH=
UPC_CARD_EXP_YEAR=
UPC_CARD_CVV=

# Optional tracking ID for create-token; required for other operations.
# If omitted for create-token, a random six-digit ID is generated.
UPC_TRACKING_ID=

# Existing token/card details for demo:operation.
# Keep tracking IDs within UPC's 10-character limit.
UPC_TOKEN_ID=
UPC_CONTENT_ID=
UPC_CARD_BRAND=

# Optional reason used by delete/suspend/resume operations.
# Allowed codes: DEVICE_LOST, DEVICE_STOLEN, SUSPECTED_FRAUD,
# ACCOUNT_CLOSED, NOT_FRAUD, DEVICE_FOUND, OTHER.
UPC_REASON_CODE=
UPC_REASON=

# Result type for the SDK responses: raw (string), json, or xml.
UPC_RESULT_TYPE=raw
