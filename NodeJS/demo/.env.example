# Environment variables for the demo application
# ----------------------------------------------
# test - use the test environment for the demo application.
# production - use the production environment for the demo application.
UPC_ENVIRONMENT=

# Merchant and terminal identifiers for the demo application.
UPC_MERCHANT_ID=
UPC_TERMINAL_ID=

# Relative paths are resolved from this demo directory. Keep the key file private.
UPC_PRIVATE_KEY_PATH=

# Use only test card details while UPC_ENVIRONMENT=test.
UPC_CARD_NUMBER=
UPC_CARD_EXP_MONTH=
UPC_CARD_EXP_YEAR=
UPC_CARD_CVV=
